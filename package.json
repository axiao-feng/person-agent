{
  "name": "person-agent",
  "version": "0.8.1",
  "private": true,
  "description": "Local personal assistant powered by pi-agent",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "person-agent": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "eval:agent": "tsx src/eval.ts",
    "start": "node dist/src/cli.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File client/PersonAgent.Desktop.Tests/run.ps1"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.0",
    "@earendil-works/pi-ai": "0.86.0",
    "google-auth-library": "11.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.14",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.19.0"
}
