<UserControl x:Class="PersonAgent.Desktop.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="TaskStatusBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="draft">
                    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="needs_replan">
                    <Setter Property="Background" Value="{StaticResource Brush.Orange}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="planned">
                    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="in_progress">
                    <Setter Property="Background" Value="{StaticResource Brush.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="completed">
                    <Setter Property="Background" Value="{StaticResource Brush.Green}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,32">

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="任务" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="从线索到计划：待安排、已计划和最近完成。" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="显示已取消" IsChecked="{Binding ShowCancelled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="新建任务" Style="{StaticResource ToolButton}" Command="{Binding NewTaskCommand}" Margin="0,0,8,0" />
                    <Button Content="刷新" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Background="{StaticResource Brush.RedSoft}"
                    BorderBrush="#F0C4C0" Padding="14" Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="任务加载失败" FontWeight="SemiBold" Foreground="{StaticResource Brush.Red}" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource MutedText}" Foreground="#7A2E29" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding ShowInitialLoading, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <ProgressBar IsIndeterminate="True" Height="3" />
                <TextBlock Text="正在加载任务…" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
            </StackPanel>

            <TextBlock Text="正在更新…" Style="{StaticResource MutedText}" Foreground="{StaticResource Brush.Accent}"
                       Margin="0,0,0,8"
                       Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="暂时没有任务。点击“新建任务”开始。" Style="{StaticResource MutedText}"
                       Visibility="{Binding HasGroups, Converter={StaticResource InverseBoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" Margin="10,1,0,0" />
                            </StackPanel>
                            <TextBlock Text="这一组暂时没有任务。" Style="{StaticResource MutedText}"
                                       Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}"
                                                AutomationProperties.Name="{Binding Title}"
                                                Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource TaskStatusBar}" />
                                                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                                               FontSize="12" Opacity="0.8" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource Brush.GreenSoft}" BorderBrush="#C9E5D6" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,4,0,0"
                    Visibility="{Binding HasActionMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActionError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
