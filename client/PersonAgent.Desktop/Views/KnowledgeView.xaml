<UserControl x:Class="PersonAgent.Desktop.Views.KnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="EvidenceChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="retrying">
                    <Setter Property="Background" Value="{StaticResource Brush.OrangeSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="abstract_only">
                    <Setter Property="Background" Value="{StaticResource Brush.OrangeSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="fulltext">
                    <Setter Property="Background" Value="{StaticResource Brush.GreenSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="truncated_fulltext">
                    <Setter Property="Background" Value="{StaticResource Brush.PurpleSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EvidenceText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="retrying">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Orange}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="abstract_only">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Orange}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="fulltext">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="truncated_fulltext">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Purple}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnalysisHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="知识库" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Zotero 题录、证据状态与 Obsidian 长期卡片。" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="同步 Zotero" Style="{StaticResource ToolButton}" Command="{Binding SyncCommand}" Margin="0,0,8,0" />
                <Button Content="立即整理" Style="{StaticResource ToolButton}" Command="{Binding DigestCommand}" Margin="0,0,8,0" />
                <Button Content="刷新" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Width="200" Height="30"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter}"
                          DisplayMemberPath="Text" />
                <TextBlock Grid.Column="1" Text="{Binding OperationMessage}" Margin="14,6,0,0" TextWrapping="Wrap"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOperationError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border Style="{StaticResource CardBorder}" Background="{StaticResource Brush.RedSoft}"
                    BorderBrush="#F0C4C0" Padding="12" Margin="0,10,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#7A2E29" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource Brush.OrangeSoft}" BorderBrush="#F0D3AE" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                    Visibility="{Binding IsPartial, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding PartialMessage}" Foreground="{StaticResource Brush.Orange}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="论文列表" FontWeight="SemiBold" Margin="8,4,8,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Papers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}"
                                            Command="{Binding DataContext.SelectPaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding CreatorsText}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedText}" FontSize="12" Opacity="0.8" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource EvidenceChip}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding EvidenceText}" Style="{StaticResource EvidenceText}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Margin="8" VerticalAlignment="Top"
                                Visibility="{Binding ShowInitialLoading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar IsIndeterminate="True" Height="3" />
                        <TextBlock Text="正在加载论文…" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="没有符合筛选条件的论文。" Style="{StaticResource MutedText}" Margin="8"
                               VerticalAlignment="Top"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPaper.Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding SelectedPaper.CreatorsText}" Style="{StaticResource MutedText}" />
                                <TextBlock Text=" · " Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedPaper.DateText}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="9" Padding="8,2">
                                    <TextBlock Text="{Binding SelectedPaper.EvidenceText}" FontSize="12" />
                                </Border>
                                <TextBlock Text="{Binding SelectedPaper.TagsText}" Style="{StaticResource MutedText}"
                                           Margin="10,2,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="在 Zotero 中打开" Style="{StaticResource ToolButton}"
                                        Command="{Binding OpenZoteroCommand}" Margin="0,0,8,0" />
                                <Button Content="在 Obsidian 中打开" Style="{StaticResource ToolButton}"
                                        Command="{Binding OpenObsidianCommand}"
                                        IsEnabled="{Binding SelectedPaper.HasObsidianLink}" />
                            </StackPanel>

                            <Border Background="{StaticResource Brush.RedSoft}" BorderBrush="#F0C4C0" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="0,12,0,0"
                                    Visibility="{Binding SelectedPaper.HasError, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedPaper.AnalysisError}" Foreground="{StaticResource Brush.Red}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedPaper.RetryText}" Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding SelectedPaper.HasRetry, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="研究方向" Style="{StaticResource AnalysisHeading}" />
                            <TextBlock Text="{Binding SelectedPaper.DirectionText}" TextWrapping="Wrap" LineHeight="22" />
                            <TextBlock Text="主要成果" Style="{StaticResource AnalysisHeading}" />
                            <TextBlock Text="{Binding SelectedPaper.ResultsText}" TextWrapping="Wrap" LineHeight="22" />
                            <TextBlock Text="明确不足" Style="{StaticResource AnalysisHeading}" />
                            <TextBlock Text="{Binding SelectedPaper.LimitationsText}" TextWrapping="Wrap" LineHeight="22" />
                            <TextBlock Text="分析依据" Style="{StaticResource AnalysisHeading}" />
                            <TextBlock Text="{Binding SelectedPaper.BasisText}" TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                            <TextBlock Text="摘要" Style="{StaticResource AnalysisHeading}" />
                            <TextBlock Text="{Binding SelectedPaper.AbstractText}" TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasDetail, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="选择一篇论文查看分析" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                        <TextBlock Text="左侧列表只显示状态；完整分析、证据与打开入口在这里。" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
