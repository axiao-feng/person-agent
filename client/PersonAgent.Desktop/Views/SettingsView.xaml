<UserControl x:Class="PersonAgent.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="ConnectionStateChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="available">
                    <Setter Property="Background" Value="{StaticResource Brush.GreenSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="unavailable">
                    <Setter Property="Background" Value="{StaticResource Brush.RedSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="not_configured">
                    <Setter Property="Background" Value="{StaticResource Brush.OrangeSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,32">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="连接状态、自动化和本地服务诊断。" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新状态" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Content="打开诊断目录" Style="{StaticResource ToolButton}" Command="{Binding DiagnosticsCommand}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Background="{StaticResource Brush.RedSoft}"
                    BorderBrush="#F0C4C0" Padding="12" Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#7A2E29" TextWrapping="Wrap" />
            </Border>

            <StackPanel Visibility="{Binding ShowInitialLoading, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,10">
                <ProgressBar IsIndeterminate="True" Height="3" />
                <TextBlock Text="正在读取设置和连接状态…" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
            </StackPanel>

            <TextBlock Text="连接" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Connections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" />
                                    <Border Grid.Column="1" Style="{StaticResource ConnectionStateChip}">
                                        <TextBlock Text="{Binding StateText}" FontSize="12" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,5,0,0"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="自动化" Style="{StaticResource SectionTitle}" Margin="0,12,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="晨间简报" FontWeight="SemiBold" />
                        <CheckBox Content="启用" IsChecked="{Binding BriefingEnabled}" Margin="0,8,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="时间" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding BriefingTime, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="30"
                                     VerticalContentAlignment="Center" ToolTip="HH:mm" />
                        </StackPanel>
                        <TextBlock Text="{Binding BriefingLast}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding BriefingNext}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="晚间知识整理" FontWeight="SemiBold" />
                        <CheckBox Content="启用" IsChecked="{Binding DigestEnabled}" Margin="0,8,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="时间" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding DigestTime, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="30"
                                     VerticalContentAlignment="Center" ToolTip="HH:mm" />
                        </StackPanel>
                        <TextBlock Text="{Binding DigestLast}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding DigestNext}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="本地路径与时区" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Text="时区（IANA）" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,10"
                             VerticalContentAlignment="Center" />
                    <TextBlock Text="Obsidian 知识库目录" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="保存设置" Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding SaveMessage}" Margin="12,6,0,0" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaveError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="长期记忆" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Text="只有你明确要求记住的信息，或明确纠正过的事实才会写入。记忆会随每次提问进入上下文；删除后立即不再可用。"
                               Style="{StaticResource MutedText}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding MemoryKinds}"
                                  SelectedItem="{Binding SelectedMemoryKind}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.Name="记忆类型" />
                        <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding MemoryDraft, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如：偏好上午阅读论文"
                                 AutomationProperties.Name="新的记忆内容" />
                        <Button Grid.Column="2" Content="记住" Style="{StaticResource ToolButton}"
                                Command="{Binding AddMemoryCommand}" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding MemoryMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasMemoryMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoryError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="还没有保存任何长期记忆。" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Visibility="{Binding HasNoMemories, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Memories}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="8"
                                        Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                       Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30" VerticalContentAlignment="Center"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="编辑" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.EditMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="保存" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.SaveMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="取消" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.CancelEditMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="删除" Style="{StaticResource ToolButton}"
                                                    Command="{Binding DataContext.DeleteMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="本地服务" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding ServiceVersion, StringFormat=本地服务版本：{0}}" />
                    <TextBlock Text="{Binding WorkerStatus, StringFormat=后台任务：{0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
