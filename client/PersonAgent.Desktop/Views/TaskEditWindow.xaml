<Window x:Class="PersonAgent.Desktop.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑任务"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Window}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        Foreground="{StaticResource Brush.Text}">
    <StackPanel Margin="22">
        <TextBlock Text="标题" Style="{StaticResource MutedText}" />
        <TextBox x:Name="TitleTextBox" Height="32" Margin="0,4,0,10" VerticalContentAlignment="Center" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="类型" Style="{StaticResource MutedText}" />
                <ComboBox x:Name="KindComboBox" Height="32" Margin="0,4,0,10">
                    <ComboBoxItem Content="科研任务" />
                    <ComboBoxItem Content="作业" />
                    <ComboBoxItem Content="其他" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="优先级" Style="{StaticResource MutedText}" />
                <ComboBox x:Name="PriorityComboBox" Height="32" Margin="0,4,0,10">
                    <ComboBoxItem Content="低" />
                    <ComboBoxItem Content="中" />
                    <ComboBoxItem Content="高" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="预计耗时（分钟）" Style="{StaticResource MutedText}" />
        <TextBox x:Name="MinutesTextBox" Height="32" Margin="0,4,0,10" VerticalContentAlignment="Center" />

        <TextBlock Text="截止时间（清空日期表示取消截止）" Style="{StaticResource MutedText}" />
        <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="DeadlineDatePicker" Grid.Column="0" Height="32" SelectedDateFormat="Short" />
            <TextBox x:Name="DeadlineTimeTextBox" Grid.Column="2" Height="32" VerticalContentAlignment="Center"
                     ToolTip="HH:mm，留空默认 18:00" />
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Red}" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="SaveButton" Content="保存" Style="{StaticResource ToolButton}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
