<UserControl x:Class="PersonAgent.Desktop.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="SourceBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SourceKey}" Value="google">
                    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceKey}" Value="lecture">
                    <Setter Property="Background" Value="{StaticResource Brush.Purple}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceKey}" Value="task">
                    <Setter Property="Background" Value="{StaticResource Brush.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceKey}" Value="approval">
                    <Setter Property="Background" Value="{StaticResource Brush.Orange}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EvidenceChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="retrying">
                    <Setter Property="Background" Value="{StaticResource Brush.OrangeSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="abstract_only">
                    <Setter Property="Background" Value="{StaticResource Brush.OrangeSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="fulltext">
                    <Setter Property="Background" Value="{StaticResource Brush.GreenSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="truncated_fulltext">
                    <Setter Property="Background" Value="{StaticResource Brush.PurpleSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EvidenceText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="retrying">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Orange}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="abstract_only">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Orange}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="fulltext">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EvidenceKey}" Value="truncated_fulltext">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Purple}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,32">

            <Border Style="{StaticResource CardBorder}"
                    Background="{StaticResource Brush.RedSoft}"
                    BorderBrush="#F0C4C0"
                    Padding="14"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="今日数据未能加载" FontWeight="SemiBold" Foreground="{StaticResource Brush.Red}" />
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource MutedText}"
                                   Foreground="#7A2E29" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="重试" Style="{StaticResource ToolButton}"
                                Command="{Binding RetryCommand}" Margin="0,0,0,6" />
                        <Button Content="打开诊断" Style="{StaticResource ToolButton}"
                                Command="{Binding DiagnosticsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{StaticResource Brush.OrangeSoft}"
                    BorderBrush="#F0D3AE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,14"
                    Visibility="{Binding IsPartial, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding PartialMessage}" Foreground="{StaticResource Brush.Orange}" TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource Brush.GreenSoft}"
                    BorderBrush="#C9E5D6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasActionMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActionError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel Visibility="{Binding ShowInitialLoading, Converter={StaticResource BoolToVisibility}}" Margin="0,20,0,0">
                <ProgressBar IsIndeterminate="True" Height="3" />
                <TextBlock Text="正在加载今日数据…" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
            </StackPanel>

            <Grid Margin="0,0,0,18" Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource PageTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding GreetingText}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text=" · " FontSize="13" Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding WeatherText}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                    <TextBlock Text="正在更新…" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                               Foreground="{StaticResource Brush.Accent}"
                               Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">

                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="今日重点" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="今天暂时没有需要处理的重点。"
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding HasFocus, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding FocusItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}"
                                        Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource Brush.Accent}" CornerRadius="1.5" />
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="{StaticResource Brush.AccentSoft}" CornerRadius="8" Padding="7,1">
                                                    <TextBlock Text="{Binding ReasonText}" FontSize="12"
                                                               Foreground="{StaticResource Brush.Accent}" />
                                                </Border>
                                                <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource MutedText}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="今日时间线" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding CalendarHint}" Style="{StaticResource MutedText}" Margin="0,-4,0,8"
                               Visibility="{Binding HasCalendarHint, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="今天暂时没有已安排事项。"
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding HasTimeline, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding TimelineItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}"
                                        Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SourceBar}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource MutedText}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Margin="4,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource MutedText}"
                                                       HorizontalAlignment="Right" FontSize="12" Opacity="0.8" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="今日知识流" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="今天没有新的论文记录。"
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding HasKnowledge, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding KnowledgeItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}"
                                        Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding CreatorsText}" Style="{StaticResource MutedText}" />
                                                <TextBlock Text=" · " Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource EvidenceChip}">
                                            <TextBlock Text="{Binding EvidenceText}" Style="{StaticResource EvidenceText}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding HasApprovals, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="待审批" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="以下操作尚未写入 Google Calendar。" Style="{StaticResource MutedText}" Margin="0,-4,0,8" />
                    <ItemsControl ItemsSource="{Binding Approvals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}"
                                        Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,0,8">
                                    <Border Background="{StaticResource Brush.OrangeSoft}" BorderBrush="#F0D3AE"
                                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Target}" FontSize="12"
                                                           Foreground="{StaticResource Brush.Orange}" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ReasonText}" Style="{StaticResource MutedText}"
                                                           Margin="0,3,0,0"
                                                           Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="建议时间" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text=" " />
                                                    <TextBlock Text="{Binding ProposedText}" Style="{StaticResource MutedText}"
                                                               Foreground="{StaticResource Brush.Text}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="尚未写入" FontSize="12" Foreground="{StaticResource Brush.Orange}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="Calendar" FontSize="12" Foreground="{StaticResource Brush.Orange}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
