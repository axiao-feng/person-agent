<UserControl x:Class="PersonAgent.Desktop.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="EventSourceBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SourceKey}" Value="google">
                    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceKey}" Value="lecture">
                    <Setter Property="Background" Value="{StaticResource Brush.Purple}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceKey}" Value="task">
                    <Setter Property="Background" Value="{StaticResource Brush.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceKey}" Value="approval">
                    <Setter Property="Background" Value="{StaticResource Brush.Orange}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EventCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Conflict}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Red}" />
                    <Setter Property="Background" Value="{StaticResource Brush.RedSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsApproval}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.OrangeSoft}" />
                    <Setter Property="BorderBrush" Value="#F0D3AE" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="日历" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding WeekTitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="上一周" Style="{StaticResource ToolButton}" Command="{Binding PreviousWeekCommand}" Margin="0,0,6,0" />
                <Button Content="本周" Style="{StaticResource ToolButton}" Command="{Binding CurrentWeekCommand}" Margin="0,0,6,0" />
                <Button Content="下一周" Style="{StaticResource ToolButton}" Command="{Binding NextWeekCommand}" Margin="0,0,8,0" />
                <Button Content="刷新" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Border Style="{StaticResource CardBorder}" Background="{StaticResource Brush.RedSoft}"
                    BorderBrush="#F0C4C0" Padding="12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#7A2E29" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource Brush.OrangeSoft}" BorderBrush="#F0D3AE" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding IsPartial, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding PartialMessage}" Foreground="{StaticResource Brush.Orange}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Accent}" TextWrapping="Wrap"
                       Margin="2,0,0,8"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="正在更新…" Style="{StaticResource MutedText}" Foreground="{StaticResource Brush.Accent}"
                       Margin="2,0,0,8"
                       Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Days}" MinWidth="980">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,8,0"
                                Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="5" Padding="6,4" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" />
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Style="{StaticResource EventCard}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource EventSourceBar}" />
                                                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                                <TextBlock Text="{Binding TimeText}" FontSize="12"
                                                                           Foreground="{StaticResource Brush.TextMuted}" />
                                                                <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                                                                           Margin="0,1,0,0" />
                                                                <TextBlock Text="{Binding SourceText}" FontSize="12" Opacity="0.75"
                                                                           Foreground="{StaticResource Brush.TextMuted}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowInitialLoading, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="220" Height="3" />
                <TextBlock Text="正在加载日历…" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
