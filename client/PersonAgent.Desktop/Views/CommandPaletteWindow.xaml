<Window x:Class="PersonAgent.Desktop.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索 / 问 Agent"
        Width="820"
        Height="680"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        Foreground="{StaticResource Brush.Text}">
    <Window.Resources>
        <Style x:Key="TypeChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeKey}" Value="paper">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeKey}" Value="task">
                    <Setter Property="Background" Value="{StaticResource Brush.GreenSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeKey}" Value="idea">
                    <Setter Property="Background" Value="{StaticResource Brush.PurpleSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeKey}" Value="lecture">
                    <Setter Property="Background" Value="{StaticResource Brush.OrangeSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.4*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.6*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="QueryTextBox" Grid.Row="0" Height="40" FontSize="16"
                 VerticalContentAlignment="Center" Padding="12,0"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="QueryTextBox_KeyDown"
                 ToolTip="输入后自动搜索；Enter 搜索，Ctrl+Enter 问 Agent" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
            <Button Content="搜索" Style="{StaticResource ToolButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0" />
            <Button Content="问 Agent" Style="{StaticResource ToolButton}" Command="{Binding AskCommand}" Margin="0,0,8,0" />
            <Button Content="快速记录" Style="{StaticResource ToolButton}" Click="QuickCapture_Click" />
            <TextBlock Text="搜索结果来自本地库；Agent 回答是模型生成，二者分区展示。"
                       Style="{StaticResource MutedText}" Margin="14,6,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,12,14,6">
                    <TextBlock Text="库内搜索结果" FontWeight="SemiBold" />
                    <TextBlock Text="（事实数据，不是模型回答）" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                    <TextBlock Text="正在搜索…" Style="{StaticResource MutedText}" Margin="12,0,0,0"
                               Foreground="{StaticResource Brush.Accent}"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Results_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource TypeChip}" VerticalAlignment="Top" Margin="0,2,10,0">
                                    <TextBlock Text="{Binding TypeText}" FontSize="12" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Snippet}" Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                               Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" FontSize="12" Opacity="0.8" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="没有匹配的库内结果。" Style="{StaticResource MutedText}"
                           Margin="16,10" VerticalAlignment="Top"
                           Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,14,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Agent 对话" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ConversationHint}" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                <TextBlock Text="正在生成…" Style="{StaticResource MutedText}" Margin="12,0,0,0"
                           Foreground="{StaticResource Brush.Orange}"
                           Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="正在读取上次对话…" Style="{StaticResource MutedText}" Margin="12,0,0,0"
                           Foreground="{StaticResource Brush.Accent}"
                           Visibility="{Binding IsLoadingTranscript, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="新对话" Style="{StaticResource ToolButton}" Command="{Binding NewConversationCommand}"
                        Margin="0,0,6,0" ToolTip="清空当前对话；下一次提问会新建会话" />
                <Button Content="删除对话" Style="{StaticResource ToolButton}" Command="{Binding DeleteConversationCommand}"
                        ToolTip="永久删除当前对话及其消息" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <ScrollViewer x:Name="TranscriptScrollViewer" VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <ItemsControl ItemsSource="{Binding Transcript}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,9" Padding="10,8" CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.OrangeSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTool}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.PurpleSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding RoleText}" FontSize="12"
                                                   Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="还没有对话。输入问题后按 Ctrl+Enter 提问；关闭窗口后仍可继续上次对话。"
                           Style="{StaticResource MutedText}" Margin="16,14" VerticalAlignment="Top"
                           Visibility="{Binding HasTranscript, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>

        <ItemsControl Grid.Row="5" ItemsSource="{Binding References}" Margin="2,10,2,0"
                      Visibility="{Binding HasReferences, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ToolButton}" Margin="0,0,6,6" Padding="9,3"
                            Command="{Binding DataContext.OpenReferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="打开这条回答依据的本地对象">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Red}"
                   TextWrapping="Wrap" Margin="2,10,2,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
